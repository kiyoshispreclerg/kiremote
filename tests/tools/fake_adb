"""A stand-in adb for kiremote-mirror's tests (KIREMOTE_ADB points at it).

Every call is appended to $FAKEADB_LOG (one line, the arguments joined by
spaces). The port of the last `reverse` is kept in $FAKEADB_LOG.port; `shell`
then plays the phone's server: connects there (video, then audio if audio=true, then control unless
control=false) and sends $FAKEADB_STREAM (a capture) on the first; the second
echoes what it gets. Then it waits until the client closes. $FAKEADB_MODE changes it:

  unauthorized   `devices -l` lists the phone as unauthorized
  push-fails     `push` fails as adb does
  dies           the server prints an error and exits without connecting
  silent         the server never connects (the client times out)
  nousb          no phone on USB (`devices -l` lists only what `connect` made)
  usb+tcpip      the phone is on USB; `tcpip` makes `connect` work from then on
  nowifi         `shell ip route` shows no Wi-Fi
  refused        `connect` always fails (adb prints that and still exits 0)

`connect HOST:PORT` adds a phone with that serial to `devices -l`. The Wi-Fi
address of the phone is 192.168.1.42.
"""
import os, socket, sys, time

args = sys.argv[1:]
log = os.environ['FAKEADB_LOG']
mode = os.environ.get('FAKEADB_MODE', '')
with open(log, 'a') as f:
    f.write(' '.join(args) + '\n')
if len(args) >= 2 and args[0] == '-s':
    args = args[2:]
connected = log + '.connected'
tcpip_on = log + '.tcpip'

def usb_line():
    return 'FAKE123                device usb:1-1 product:fake model:Fake_Phone device:fake transport_id:7'

if args[:2] == ['devices', '-l']:
    state = 'unauthorized' if mode == 'unauthorized' else 'device'
    print('List of devices attached')
    if mode not in ('nousb',):
        print(f'FAKE123                {state} usb:1-1 product:fake model:Fake_Phone device:fake transport_id:7')
    if os.path.exists(connected):
        print(f'{open(connected).read().strip():22} device product:fake model:Fake_Phone device:fake transport_id:8')
    sys.exit(0)
if args[:3] == ['shell', 'ip', 'route']:
    print('10.12.0.0/16 dev rmnet_data1 proto kernel scope link src 10.12.4.9\r')
    if mode != 'nowifi':
        print('192.168.1.0/24 dev wlan0  proto kernel  scope link  src 192.168.1.42\r')
    sys.exit(0)
if args[:1] == ['tcpip']:
    open(tcpip_on, 'w').write(args[1])
    print('restarting in TCP mode port: ' + args[1])
    sys.exit(0)
if args[:1] == ['connect']:
    # Like adb: failure is on stdout, with exit code 0. With usb+tcpip it
    # only works once `tcpip` ran, and not on the first try (adbd restarting).
    count = log + '.connects'
    n = int(open(count).read()) + 1 if os.path.exists(count) else 1
    open(count, 'w').write(str(n))
    if mode == 'refused' or (mode == 'usb+tcpip' and (not os.path.exists(tcpip_on) or n < 3)):
        print(f"failed to connect to '{args[1]}': Connection refused")
        sys.exit(0)
    open(connected, 'w').write(args[1])
    print(f'connected to {args[1]}')
    sys.exit(0)
if args[:1] == ['push']:
    if mode == 'push-fails':
        print("adb: error: failed to copy 'x' to '/data/local/tmp/x': remote Read-only file system", file=sys.stderr)
        sys.exit(1)
    if not os.path.isfile(args[1]):
        sys.exit(1)
    print(f'{args[1]}: 1 file pushed.')
    sys.exit(0)
if args[:1] == ['reverse']:
    if args[1] != '--remove':
        with open(log + '.port', 'w') as f:
            f.write(args[2].split(':')[1])
    sys.exit(0)
if args[:1] == ['shell']:
    print('[server] INFO: Device: [Fake] Fake_Phone (Android 12)', flush=True)
    if mode == 'dies':
        print('[server] ERROR: The server version (5.0.1) does not match the client', flush=True)
        sys.exit(1)
    if mode == 'silent':
        time.sleep(30)
        sys.exit(0)
    port = int(open(log + '.port').read())
    s = socket.create_connection(('127.0.0.1', port))
    # The audio socket (opus-less: the test only looks at the fd), then the
    # control socket, unless turned off: it echoes what it gets.
    a = socket.create_connection(('127.0.0.1', port)) if 'audio=true' in args else None
    c = None if 'control=false' in args else socket.create_connection(('127.0.0.1', port))
    s.sendall(open(os.environ['FAKEADB_STREAM'], 'rb').read())
    if c:
        while True:
            b = c.recv(4096)
            if not b:
                break
            c.sendall(b)
    s.recv(1)  # until the client closes
    sys.exit(0)
print('fake_adb: unexpected', args, file=sys.stderr)
sys.exit(1)
