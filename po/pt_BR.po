#: src/kiremote-cli.c:29
#, c-format
msgid ""
"Usage: %s [OPTION]...\n"
"Controls kiremoted, the phone connection daemon.\n"
"\n"
"  -l, --list            list the devices (paired, and the ones around)\n"
"      --status          the daemon's state and the devices\n"
"      --schema          list the settings and their defaults\n"
"      --get [KEY]       show the settings (or just KEY, as section.key)\n"
"      --set KEY=VALUE   change a setting (an empty VALUE: back to the "
"default)\n"
"      --unset KEY       back to the default\n"
"      --watch           print events (devices, pairing requests, settings)\n"
"                        as JSON lines until interrupted\n"
"      --json            print the daemon's reply as JSON (with the options "
"above)\n"
"  -d, --device ID       the device for the options below (id or name)\n"
"      --pair            ask to pair (or accept its request) and wait\n"
"      --unpair          unpair (or refuse its request)\n"
"      --ping            send a ping\n"
"      --ping-msg TEXT   send a ping with a message\n"
"      --share FILE      send a file (may be repeated)\n"
"      --share-text TEXT send text (it goes to the phone's clipboard)\n"
"      --share-url URL   send a link (the phone opens it)\n"
"      --find-phone      make the phone ring\n"
"      --browse-files    mount the phone's files and open them\n"
"      --unmount-files   unmount the phone's files\n"
"      --stop-ring       stop this computer's sound (when the phone looks for "
"it)\n"
"      --mute-call       silence the phone's ringing call\n"
"      --refresh         announce this computer on the network again\n"
"  -s, --socket PATH     the daemon's control socket\n"
"  -V, --version         show the version and exit\n"
"  -h, --help            show this help and exit\n"
msgstr ""
"Uso: %s [OPÇÃO]...\n"
"Controla o kiremoted, o daemon de conexão com o celular.\n"
"\n"
"  -l, --list             lista os dispositivos (pareados e os que estão por "
"perto)\n"
"      --status           o estado do daemon e os dispositivos\n"
"      --schema           lista as configurações e seus padrões\n"
"      --get [CHAVE]      mostra as configurações (ou só CHAVE, como seção."
"chave)\n"
"      --set CHAVE=VALOR  muda uma configuração (VALOR vazio: volta ao "
"padrão)\n"
"      --unset CHAVE      volta ao padrão\n"
"      --watch            imprime os eventos (dispositivos, pedidos de "
"pareamento,\n"
"                         configurações) como linhas JSON até ser "
"interrompido\n"
"      --json             imprime a resposta do daemon em JSON (com as opções "
"acima)\n"
"  -d, --device ID        o dispositivo das opções abaixo (id ou nome)\n"
"      --pair             pede o pareamento (ou aceita o pedido dele) e "
"espera\n"
"      --unpair           desfaz o pareamento (ou recusa o pedido dele)\n"
"      --ping             manda um ping\n"
"      --ping-msg TEXTO   manda um ping com uma mensagem\n"
"      --share ARQUIVO    envia um arquivo (pode repetir)\n"
"      --share-text TEXTO envia um texto (vai para o clipboard do celular)\n"
"      --share-url URL    envia um link (o celular abre)\n"
"      --find-phone       faz o celular tocar\n"
"      --browse-files     monta os arquivos do celular e os abre\n"
"      --unmount-files    desmonta os arquivos do celular\n"
"      --stop-ring        para o som deste computador (quando o celular o "
"procura)\n"
"      --mute-call        silencia a chamada que está tocando no celular\n"
"      --refresh          anuncia este computador na rede de novo\n"
"  -s, --socket CAMINHO   o socket de controle do daemon\n"
"  -V, --version          mostra a versão e sai\n"
"  -h, --help             mostra esta ajuda e sai\n"

