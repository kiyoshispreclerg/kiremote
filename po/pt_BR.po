"  -v, --verbose      debug messages\n"
"  -V, --version      show the version and exit\n"
"  -h, --help         show this help and exit\n"
msgstr ""
"Uso: %s [OPÇÃO]...\n"
"Conecta este computador ao seu celular (protocolo do KDE Connect).\n"
"\n"
"  -c, --config ARQUIVO  arquivo de configuração\n"
"                        (padrão ~/.config/kiremote/kiremote.ini)\n"
"  -s, --socket CAMINHO  socket de controle\n"
"                        (padrão $XDG_RUNTIME_DIR/kiremote.sock)\n"
"  -v, --verbose         mensagens de depuração\n"
"  -V, --version         mostra a versão e sai\n"
