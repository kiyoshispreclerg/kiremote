#: src/kiremote-cli.c:29
#, c-format
msgid ""
"Usage: %s [OPTION]...\n"
"Controls kiremoted, the phone connection daemon.\n"
"\n"
"  -l, --list            list the devices (paired, and the ones around)\n"
"      --status          the daemon's state and the devices\n"
"      --schema          list the settings and their defaults\n"
"      --get [KEY]       show the settings (or just KEY, as section.key)\n"
"      --set KEY=VALUE   change a setting (an empty VALUE: back to the "
"default)\n"
"      --unset KEY       back to the default\n"
"      --watch           print events (devices, pairing requests, settings)\n"
"                        as JSON lines until interrupted\n"
"      --json            print the daemon's reply as JSON (with the options "
"above)\n"
"  -d, --device ID       the device for the options below (id or name)\n"
"      --pair            ask to pair (or accept its request) and wait\n"
"      --unpair          unpair (or refuse its request)\n"
"      --ping            send a ping\n"
"      --ping-msg TEXT   send a ping with a message\n"
"      --share FILE      send a file (may be repeated)\n"
"      --share-text TEXT send text (it goes to the phone's clipboard)\n"
"      --share-url URL   send a link (the phone opens it)\n"
"      --find-phone      make the phone ring\n"
"      --browse-files    mount the phone's files and open them\n"
"      --unmount-files   unmount the phone's files\n"
"      --stop-ring       stop this computer's sound (when the phone looks for "
"it)\n"
"      --mute-call       silence the phone's ringing call\n"
"      --refresh         announce this computer on the network again\n"
"  -s, --socket PATH     the daemon's control socket\n"
"  -V, --version         show the version and exit\n"
"  -h, --help            show this help and exit\n"
msgstr ""
"Usage: %s [OPTION]...\n"
"Controls kiremoted, the phone connection daemon.\n"
"\n"
"  -l, --list            list the devices (paired, and the ones around)\n"
"      --status          the daemon's state and the devices\n"
"      --schema          list the settings and their defaults\n"
"      --get [KEY]       show the settings (or just KEY, as section.key)\n"
"      --set KEY=VALUE   change a setting (an empty VALUE: back to the "
"default)\n"
"      --unset KEY       back to the default\n"
"      --watch           print events (devices, pairing requests, settings)\n"
"                        as JSON lines until interrupted\n"
"      --json            print the daemon's reply as JSON (with the options "
"above)\n"
"  -d, --device ID       the device for the options below (id or name)\n"
"      --pair            ask to pair (or accept its request) and wait\n"
"      --unpair          unpair (or refuse its request)\n"
"      --ping            send a ping\n"
"      --ping-msg TEXT   send a ping with a message\n"
"      --share FILE      send a file (may be repeated)\n"
"      --share-text TEXT send text (it goes to the phone's clipboard)\n"
"      --share-url URL   send a link (the phone opens it)\n"
"      --find-phone      make the phone ring\n"
"      --browse-files    mount the phone's files and open them\n"
"      --unmount-files   unmount the phone's files\n"
"      --stop-ring       stop this computer's sound (when the phone looks for "
"it)\n"
"      --mute-call       silence the phone's ringing call\n"
"      --refresh         announce this computer on the network again\n"
"  -s, --socket PATH     the daemon's control socket\n"
"  -V, --version         show the version and exit\n"
"  -h, --help            show this help and exit\n"

